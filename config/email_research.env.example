# Proven performance-canary defaults. Override per environment without code changes.
# Full-path Speed Canary (100 clinics, real SerpAPI, 2026-10-10/11) found 8 workers both
# faster and more reliable than 12 against the current SerpAPI plan: 8 workers -> 82.19s
# wall / 4,382 clinics-hour / 0 SerpAPI timeout / 0 retry; 12 workers -> 128.48s wall /
# 2,802 clinics-hour / 21 SerpAPI timeout / 16 retry (provider-side concurrency limiting
# at 12 concurrent workers). See artifacts/email_speed_canary_100_fullpath_20261010T2351Z/
# and artifacts/email_speed_canary_worker_compare_20261010T1405Z/. Recommended override
# for the single-Mac runtime: EMAIL_RESEARCH_WORKERS=8
EMAIL_RESEARCH_WORKERS=8
EMAIL_RESEARCH_CONNECT_TIMEOUT_SECONDS=10
EMAIL_RESEARCH_READ_TIMEOUT_SECONDS=20
EMAIL_RESEARCH_RETRY_COUNT=1
EMAIL_RESEARCH_SEARCH_QUERY_LIMIT=2
EMAIL_RESEARCH_CLAIM_LEASE_SECONDS=300
EMAIL_RESEARCH_IDLE_POLL_SECONDS=2
EMAIL_RESEARCH_TARGET_SYNC_INTERVAL_SECONDS=30
# Keep disabled until the separate Production validation gate is approved.
EMAIL_AUTO_RUN_ENABLED=false
# Dedicated shared, non-Production Email state DB. Never reuse SUPABASE_RUNTIME_DB_URL.
# EMAIL_RESEARCH_DB_URL=postgresql://<clinic_email_runtime>:<password>@<email-db-host>:5432/<email-db>
# Dedicated SELECT-only connection to the Clinic/HP source. Never use an admin URL.
# CLINIC_READONLY_DB_URL=postgresql://<select_only_user>:<password>@<clinic-db-host>:5432/<clinic-db>
# Fail-closed by default: "cross_database" (or unset) requires EMAIL_RESEARCH_DB_URL and
# SUPABASE_RUNTIME_DB_URL to be different databases. Set to "same_database" ONLY when
# Email Research schemas were migrated into the Production database itself (see
# scripts/supabase_migration/email_research_schema.sql) -- in that mode the connecting
# user on EMAIL_RESEARCH_DB_URL must still differ from SUPABASE_RUNTIME_DB_URL's user, and
# must be the least-privilege clinic_email_runtime role, never clinic_runtime.
EMAIL_RESEARCH_DB_MODE=cross_database
# Canary safety default; final TRUE/MEDIUM policy is decided after offline comparison.
EMAIL_RESEARCH_PRIMARY_MINIMUM_CONFIDENCE=HIGH
