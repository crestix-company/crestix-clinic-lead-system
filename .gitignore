# 効果測定ダッシュボード: Google Sheets READ ONLYサービスアカウントの鍵。絶対にコミットしない。
*service-account*.json
*-sheets-readonly*.json
outreach-sheets-readonly*.json
*.sqlite3*
*.db*
*.bak
*.lock
*.log
data/cache/*.tmp

# baseline import: minimum excludes
venv/
.venv_mac/
*.pyc
.DS_Store
Thumbs.db
node_modules/

# Performance Phase: 実医院のHTTP応答・DB複製・計測生データ（Gitへ入れない）
.perf-replay/

# Production DB: 可変データなのでGit管理しない（git switch/restore/reset等での巻き戻り事故を防ぐ）。
# *.sqlite3* で既にカバーされるが、本番ファイルは明示的にも列挙しておく。
/data/clinics.sqlite3
/data/clinics.sqlite3-wal
/data/clinics.sqlite3-shm
/data/clinics.sqlite3-journal

# Phase 7 Full Run: 医院一覧・HP URL・進捗・キャッシュ等の生成物（Gitへ入れない）。
# manifest/progress/cacheのスキーマはsource(scripts/*.py)側で管理する。
/data/manifests/
/data/research_worker/
.venv_research/
